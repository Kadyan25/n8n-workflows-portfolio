        "jsCode": "const now = new Date();\nconst opts = {\n  timeZone: 'Asia/Kolkata',\n  hour12: false,\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit',\n  hour: '2-digit',\n  minute: '2-digit',\n  second: '2-digit'\n};\n\nconst parts = new Intl.DateTimeFormat('en-GB', opts).formatToParts(now);\nconst get = (t) => parts.find(p => p.type === t).value;\nconst ts = `${get('day')}/${get('month')}/${get('year')} ${get('hour')}:${get('minute')}:${get('second')} IST`;\n\nconst accounts = $input.all().map(i => i.json);\n\nreturn accounts.map(a => ({\n  json: {\n    accountname: a.account_name,\n    connectionssenttoday: 0,\n    dmssenttoday: 0,\n    lastchecked: ts\n  }\n}));"
      },
